---
interface Props {
  images: string[];
  title?: string;
  height?: number;
  width?: number;
}

const { images, title, height = 600, width = 1000 } = Astro.props;
---

<div
  class="flipbook-container max-w-7xl mx-auto px-4 pb-16"
  style={`--flipbook-height: ${height}px; --flipbook-width: ${width}px`}
>
  {
    title && (
      <h1 class="text-4xl text-center mb-12" style="font-weight: 200;">
        {title}
      </h1>
    )
  }

  <div id="flipbook" class="flipbook">
    {
      images.map((image, index) => (
        <div class:list={['page', index === images.length - 1 ? 'hard' : '']} data-page-index={index}>
          <img src={image} alt={`Page ${index + 1}`} class="page-image" />
        </div>
      ))
    }
  </div>

  <!-- Navigation Controls -->
  <div class="navigation-controls flex justify-center items-center gap-2 md:gap-8 mt-8">
    <button
      id="prevBtn"
      class="nav-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      aria-label="Previous page"
    >
      ← Prev
    </button>

    <div class="page-counter text-sm md:text-lg text-center">
      <span id="currentPage">1</span> / <span id="totalPages">{images.length}</span>
    </div>

    <button
      id="nextBtn"
      class="nav-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      aria-label="Next page"
    >
      Next →
    </button>
  </div>
</div>

<style>
  .flipbook-container {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flipbook {
    width: var(--flipbook-width, 1000px);
    height: var(--flipbook-height, 600px);
  }

  @media (max-width: 768px) {
    .flipbook {
      width: 90vw !important;
      height: 60vh !important;
    }
  }

  .page {
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .page.hard {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page.even {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page.odd {
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .flipbook {
      width: 95%;
      height: 400px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    // Wait for jQuery and turn.js to be available
    function initFlipbook() {
      if (typeof jQuery === 'undefined' || typeof jQuery.fn.turn === 'undefined') {
        setTimeout(initFlipbook, 100);
        return;
      }

      const flipbook = document.getElementById('flipbook');
      if (!flipbook) return;

      // Check if already initialized
      if (flipbook.classList.contains('turn-initialized')) {
        return;
      }

      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const currentPageEl = document.getElementById('currentPage');
      const totalPages = parseInt(document.getElementById('totalPages')?.textContent || '0');

      // Initialize turn.js with responsive settings
      const isMobile = window.innerWidth < 768;

      // Add blank first page only on desktop for double-page spread
      if (!isMobile) {
        const blankPage = document.createElement('div');
        blankPage.className = 'page blank-page';
        blankPage.style.background = 'white';
        flipbook.insertBefore(blankPage, flipbook.firstChild);
      }

      const customHeight = parseInt(flipbook.parentElement?.style.getPropertyValue('--flipbook-height') || '600');

      const customWidth = parseInt(flipbook.parentElement?.style.getPropertyValue('--flipbook-width') || '1000');

      jQuery(flipbook).turn({
        width: isMobile ? window.innerWidth * 0.9 : customWidth,
        height: isMobile ? window.innerHeight * 0.6 : customHeight,
        display: isMobile ? 'single' : 'double',
        autoCenter: true,
        gradients: true,
        acceleration: true,
        elevation: 50,
        duration: 1000,
      });

      // Force initial view to show pages 1 and 2 together on desktop only
      if (!isMobile) {
        jQuery(flipbook).turn('page', 2);
      }

      // Mark as initialized
      flipbook.classList.add('turn-initialized');

      // Handle window resize
      let resizeTimeout;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const nowMobile = window.innerWidth < 768;
          jQuery(flipbook).turn('display', nowMobile ? 'single' : 'double');
          jQuery(flipbook).turn(
            'size',
            nowMobile ? window.innerWidth * 0.9 : customWidth,
            nowMobile ? window.innerHeight * 0.6 : customHeight
          );
        }, 250);
      });

      function updateControls() {
        const page = jQuery(flipbook).turn('page');
        const nowMobile = window.innerWidth < 768;

        // Adjust for the blank first page on desktop only
        let displayPage;
        let isFirstPage;

        if (nowMobile) {
          // On mobile (single page mode), just show the actual page number
          displayPage = page;
          isFirstPage = page === 1;
        } else {
          // On desktop (double page mode), adjust for blank first page
          displayPage = page > 1 ? page - 1 : 1;
          isFirstPage = page === 2; // Page 2 is actually the first content page
        }

        if (currentPageEl) {
          currentPageEl.textContent = displayPage.toString();
        }
        prevBtn.disabled = isFirstPage;
        nextBtn.disabled = page === totalPages;
      }

      prevBtn.addEventListener('click', () => {
        jQuery(flipbook).turn('previous');
        updateControls();
      });

      nextBtn.addEventListener('click', () => {
        jQuery(flipbook).turn('next');
        updateControls();
      });

      jQuery(flipbook).bind('turned', function (_event, _page, _view) {
        updateControls();
      });

      // Initialize controls
      updateControls();
    }

    initFlipbook();
  });
</script>
