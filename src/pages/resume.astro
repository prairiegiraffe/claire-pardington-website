---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Resume',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-[1600px] px-4">
    <!-- PDF Embed Container -->
    <div class="pdf-container w-full" style="min-height: 1000px;">
      <object
        data="/Resume_ Pardington.pdf"
        type="application/pdf"
        class="w-full"
        style="height: 1400px;"
      >
        <p class="text-center py-8">
          Unable to display PDF.
          <a href="/Resume_ Pardington.pdf" class="underline" download>Download the resume instead</a>
        </p>
      </object>
    </div>

    <!-- Download Button -->
    <div class="flex justify-center mt-8 mb-20">
      <a
        href="/Resume_ Pardington.pdf"
        download
        class="inline-block px-6 py-3 bg-black text-white hover:bg-gray-800 transition-colors"
      >
        Download Resume
      </a>
    </div>
  </section>
</Layout>

<style>
  .pdf-container object {
    border: 1px solid #e5e7eb;
  }
</style>
