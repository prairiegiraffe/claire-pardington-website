import img20 from '~/assets/images/the-middle-of-the-night/design-journal-2/20.webp';
import img21 from '~/assets/images/the-middle-of-the-night/design-journal-2/21.webp';
import img22 from '~/assets/images/the-middle-of-the-night/design-journal-2/22.webp';
import img23 from '~/assets/images/the-middle-of-the-night/design-journal-2/23.webp';
import img24 from '~/assets/images/the-middle-of-the-night/design-journal-2/24A.webp';
