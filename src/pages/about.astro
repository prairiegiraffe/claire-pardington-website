---
import Layout from '~/layouts/PageLayout.astro';
import aboutHeader from '~/assets/images/About Font.webp';
import portraitImage from '~/assets/images/CP-Updated.webp';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <!-- Left Column: Image and Text -->
      <div class="space-y-6">
        <div class="flex justify-center">
          <img src={aboutHeader.src} alt="About" class="h-auto" style="max-width: 200px;" />
        </div>
        <div class="prose dark:prose-invert max-w-none">
          <p>
            Claire Pardington is a New York–based designer and creative director whose work bridges fashion and visual storytelling. A graduate of the Fashion Institute of Technology, she began her career by being hand selected by Francisco Costa at Calvin Klein Collection and later became Senior Designer for the Designer Collection at Victoria's Secret. After earning her MBA from the University of Michigan's Ross School of Business—where she was named 2022's Entrepreneur of the Year—she founded Pardington Collective, a conceptual brand exploring the intersection of style, art, and experience.
          </p>
          <p>
            Blending imagination with structure, Claire creates work that feels both architectural and emotive. Her collections and concepts aim to build fully realized worlds—rooted in elegance, precision, and an enduring appreciation for beauty that resonates beyond trend.
          </p>
        </div>
        <div class="flex justify-center mt-6">
          <a href="/resume" class="inline-block px-6 py-3 bg-black text-white hover:bg-gray-800 transition-colors">
            View Resume
          </a>
        </div>
      </div>

      <!-- Right Column: Image -->
      <div class="flex justify-center">
        <img src={portraitImage.src} alt="Claire Pardington" class="w-full h-auto" style="max-width: 500px;" />
      </div>
    </div>
  </section>
</Layout>
