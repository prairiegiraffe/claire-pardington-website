---
import { Icon } from 'astro-icon/components';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links?: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [] } = Astro.props;
---

<footer class="relative bg-black text-white py-12 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <!-- Left: Company Info -->
      <div class="space-y-1 text-center md:text-left">
        <p class="text-sm font-semibold">Claire Elizabeth Pardington LLC</p>
        <p class="text-xs">Creative Director. Designer.</p>
        <p class="text-xs">© 2025 All rights reserved.</p>
        <p class="text-xs">
          <a href="mailto:clairepardington@gmail.com" class="hover:text-gray-300 transition">
            clairepardington@gmail.com
          </a>
        </p>
      </div>

      <!-- Right: Social Links -->
      <div class="flex justify-center md:justify-end">
        <ul class="flex gap-4">
          {
            socialLinks.map(({ ariaLabel, href, icon }) => (
              <li>
                <a
                  class="text-white hover:text-gray-300 transition p-2 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-6 h-6" />}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
