---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import resumePage1 from '~/assets/images/resume/Resume_ Pardington_Page_1.jpg';
import resumePage2 from '~/assets/images/resume/Resume_ Pardington_Page_2.jpg';

const metadata = {
  title: 'Resume',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-[1600px]">
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <!-- Left Column: Resume Page 1 -->
      <div>
        <Image
          src={resumePage1}
          alt="Resume Page 1"
          quality={100}
          class="w-full h-auto cursor-pointer hover:opacity-90 transition-opacity"
          style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"
          data-lightbox="true"
        />
      </div>

      <!-- Right Column: Resume Page 2 -->
      <div>
        <Image
          src={resumePage2}
          alt="Resume Page 2"
          quality={100}
          class="w-full h-auto cursor-pointer hover:opacity-90 transition-opacity"
          style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"
          data-lightbox="true"
        />
      </div>
    </div>

    <!-- Download Button -->
    <div class="flex justify-center mt-12 mb-20">
      <a
        href="/Resume_ Pardington.pdf"
        download
        class="inline-block px-6 py-3 bg-black text-white hover:bg-gray-800 transition-colors"
      >
        Download Resume
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 p-4">
    <div class="flex items-center justify-center w-full h-full">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain" style="image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;" />
    </div>
    <button id="close-lightbox" class="absolute top-4 right-4 text-white text-4xl hover:text-gray-300">&times;</button>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      const images = document.querySelectorAll('img[data-lightbox]');
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const closeBtn = document.getElementById('close-lightbox');

      images.forEach(function (img) {
        img.addEventListener('click', function () {
          lightbox.classList.remove('hidden');
          lightboxImg.src = this.src;
          document.body.style.overflow = 'hidden';
        });
      });

      closeBtn.addEventListener('click', function () {
        lightbox.classList.add('hidden');
        document.body.style.overflow = 'auto';
      });

      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) {
          lightbox.classList.add('hidden');
          document.body.style.overflow = 'auto';
        }
      });
    });
  </script>
</Layout>
