---
import Layout from '~/layouts/PageLayout.astro';
import FlipBookSingleCover from '~/components/widgets/FlipBookSingleCover.astro';
import img01 from '~/assets/images/ck-close-to-body/01.jpg';
import img02 from '~/assets/images/ck-close-to-body/02.jpg';
import img03 from '~/assets/images/ck-close-to-body/03.jpg';
import img04 from '~/assets/images/ck-close-to-body/04.jpg';
import img05 from '~/assets/images/ck-close-to-body/05.jpg';
import img06 from '~/assets/images/ck-close-to-body/06.jpg';
import img07 from '~/assets/images/ck-close-to-body/07.jpg';
import img08 from '~/assets/images/ck-close-to-body/08.jpg';
import img09 from '~/assets/images/ck-close-to-body/09.jpg';

const metadata = {
  title: 'Calvin Klein: Close to Body Collection - Claire Pardington',
};

const flipbookImages = [img01, img02, img03, img04, img05, img06, img07, img08, img09].map((img) => img.src);
---

<Layout metadata={metadata}>
  <!-- Back to Works Button -->
  <div class="py-8 pl-4 md:pl-10">
    <a
      href="/works"
      class="inline-flex items-center gap-2 text-black hover:opacity-70 transition-opacity uppercase tracking-wide text-sm"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Back to Works
    </a>
  </div>

  <!-- Title & Intro -->
  <div class="container mx-auto px-4 pt-4 pb-8">
    <h1 class="text-3xl md:text-5xl uppercase tracking-wide text-center mb-2" style="font-weight: 200;">Calvin Klein</h1>
    <h2 class="text-xl md:text-2xl tracking-wide text-center mb-8" style="font-weight: 200;">
      Close to Body [Lounge &amp; Intimates] Collection
    </h2>
    <div class="max-w-[900px] mx-auto text-base leading-relaxed">
      <p>
        Developed for the Calvin Klein interview process, this Spring 2028 lounge and sleepwear concept explores the
        evolution of comfort through three strategic pillars: Icon, Function, and Sensuality. Inspired by shifts toward
        body-aware design, fabric innovation, and simplified living, the collection reimagines Calvin Klein's signature
        minimalism through next-generation materials, engineered comfort, and modern sensuality.
      </p>
    </div>
  </div>

  <!-- Flipbook -->
  <div class="ck-flipbook-wide">
    <FlipBookSingleCover images={flipbookImages} height={500} id="ck-close-to-body" />
  </div>

  <!-- Disclaimer -->
  <div class="w-full py-12">
    <p class="text-xs tracking-wide text-center max-w-[600px] mx-auto px-4" style="font-weight: 200;">
      This project was completed as part of the Calvin Klein interview process and is presented for portfolio purposes
      only. It is not affiliated with, endorsed by, or commissioned by Calvin Klein.
    </p>
  </div>
</Layout>

<!-- Page-scoped flipbook sizing: landscape images, no cropping. Only affects this page. -->
<style is:global>
  /* Show the full landscape image instead of cropping the sides */
  .ck-flipbook-wide .page-image-single {
    object-fit: contain !important;
    background: white;
  }
</style>

<!-- Load jQuery and turn.js for the flipbook -->
<script is:inline src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script is:inline src="/turn.min.js"></script>
