import img26 from '~/assets/images/the-middle-of-the-night/design-journal-2/26.webp';
import img27 from '~/assets/images/the-middle-of-the-night/design-journal-2/27.webp';
import img28 from '~/assets/images/the-middle-of-the-night/design-journal-2/28.webp';
