---
interface Props {
  images: string[];
  title?: string;
  height?: number;
  width?: number; // Desktop book width in px (default 1000)
  id?: string; // Unique ID to prevent conflicts
}

const { images, title, height = 600, width = 1000, id = 'flipbook-single' } = Astro.props;
const uniqueId = `${id}-${Math.random().toString(36).substring(2, 11)}`;
---

<div
  class="flipbook-single-container max-w-7xl mx-auto px-4 pb-16"
  style={`--flipbook-height: ${height}px; --flipbook-width: ${width}px`}
  data-flipbook-type="single-cover"
>
  {
    title && (
      <h1 class="text-4xl text-center mb-12" style="font-weight: 200;">
        {title}
      </h1>
    )
  }

  <div id={uniqueId} class="flipbook-single" data-flipbook-id={uniqueId}>
    {
      images.map((image, index) => (
        <div class:list={['page-single', index === images.length - 1 ? 'hard' : '']} data-page-index={index}>
          <img src={image} alt={`Page ${index + 1}`} class="page-image-single" />
        </div>
      ))
    }
  </div>

  <!-- Navigation Controls -->
  <div class="navigation-controls flex justify-center items-center gap-2 md:gap-8 mt-8">
    <button
      class="nav-btn-single prev-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      data-flipbook-target={uniqueId}
      aria-label="Previous page"
    >
      ← Prev
    </button>

    <div class="page-counter text-sm md:text-lg text-center">
      <span class="current-page-single" data-flipbook-target={uniqueId}>1</span> / <span
        class="total-pages-single"
        data-flipbook-target={uniqueId}>{images.length}</span
      >
    </div>

    <button
      class="nav-btn-single next-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      data-flipbook-target={uniqueId}
      aria-label="Next page"
    >
      Next →
    </button>
  </div>
</div>

<style>
  .flipbook-single-container {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flipbook-single {
    width: var(--flipbook-width, 1000px);
    height: var(--flipbook-height, 600px);
  }

  @media (max-width: 768px) {
    .flipbook-single {
      width: 90vw !important;
      height: 60vh !important;
    }
  }

  .page-single {
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .page-single.hard {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-single.even {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-single.odd {
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-image-single {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hide flipbook pages until turn.js initializes */
  .flipbook-single .page-single {
    display: none;
  }

  .flipbook-single.turn-initialized .page-single {
    display: flex !important;
  }
</style>

<script>
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  declare const jQuery: any;

  document.addEventListener('astro:page-load', function () {
    // Initialize all single-cover flipbooks on the page
    const flipbooks = document.querySelectorAll('[data-flipbook-type="single-cover"]');

    flipbooks.forEach((container) => {
      const flipbookElement = container.querySelector('.flipbook-single') as HTMLElement;
      if (!flipbookElement) return;

      const uniqueId = flipbookElement.dataset.flipbookId;
      if (!uniqueId) return;

      // Wait for jQuery and turn.js to be available
      function initFlipbook() {
        if (typeof jQuery === 'undefined' || typeof jQuery.fn.turn === 'undefined') {
          setTimeout(initFlipbook, 100);
          return;
        }

        // Check if already initialized
        if (flipbookElement.classList.contains('turn-initialized')) {
          return;
        }

        const prevBtn = container.querySelector(
          '.prev-btn[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLButtonElement;
        const nextBtn = container.querySelector(
          '.next-btn[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLButtonElement;
        const currentPageEl = container.querySelector(
          '.current-page-single[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLElement;
        const totalPagesEl = container.querySelector(
          '.total-pages-single[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLElement;
        const totalPagesCount = parseInt(totalPagesEl?.textContent || '0');

        if (!prevBtn || !nextBtn || !currentPageEl) return;

        // Initialize turn.js with responsive settings
        const isMobile = window.innerWidth < 768;

        // For single cover on desktop:
        // Turn.js shows odd pages on the right in double mode
        // So page 1 will naturally show alone on the right (like a book cover)
        // No blank page needed!

        const customHeight = parseInt((container as HTMLElement).style.getPropertyValue('--flipbook-height') || '600');
        const customWidth = parseInt((container as HTMLElement).style.getPropertyValue('--flipbook-width') || '1000');

        jQuery(flipbookElement).turn({
          width: isMobile ? window.innerWidth * 0.9 : customWidth,
          height: isMobile ? window.innerHeight * 0.6 : customHeight,
          display: isMobile ? 'single' : 'double',
          autoCenter: true,
          gradients: true,
          acceleration: true,
          elevation: 50,
          duration: 1000,
        });

        // Start at page 1 - in double mode, this shows ONLY page 1 on the right (single cover)

        // Mark as initialized
        flipbookElement.classList.add('turn-initialized');

        // Handle window resize
        let resizeTimeout: number;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(function () {
            const nowMobile = window.innerWidth < 768;
            jQuery(flipbookElement).turn('display', nowMobile ? 'single' : 'double');
            jQuery(flipbookElement).turn(
              'size',
              nowMobile ? window.innerWidth * 0.9 : customWidth,
              nowMobile ? window.innerHeight * 0.6 : customHeight
            );
          }, 250) as unknown as number;
        });

        function updateControls() {
          const page = jQuery(flipbookElement).turn('page');

          // Display the current page number
          const displayPage: number = page;
          const isFirstPage: boolean = page === 1;

          if (currentPageEl) {
            currentPageEl.textContent = displayPage.toString();
          }
          prevBtn.disabled = isFirstPage;
          nextBtn.disabled = page === totalPagesCount;
        }

        prevBtn.addEventListener('click', () => {
          jQuery(flipbookElement).turn('previous');
          updateControls();
        });

        nextBtn.addEventListener('click', () => {
          jQuery(flipbookElement).turn('next');
          updateControls();
        });

        jQuery(flipbookElement).bind('turned', function () {
          updateControls();
        });

        // Initialize controls
        updateControls();
      }

      initFlipbook();
    });
  });
</script>
