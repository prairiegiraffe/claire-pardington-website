import img30 from '~/assets/images/the-middle-of-the-night/design-journal-2/30.webp';

const metadata = {
  title: 'Alice + Olivia: The Middle of the Night - Claire Pardington',
};

const journalImages = [
  img01.src,
  img02.src,
  img03.src,
  img04.src,
  img05.src,
  img06.src,
  img07.src,
  img08.src,
  img09.src,
  img10.src,
  img11.src,
  img12.src,
  img13.src,
  img14.src,
  img15.src,
  img16.src,
  img17.src,
  img18.src,
  img19.src,
  img20.src,
  img21.src,
  img22.src,
  img23.src,
  img24.src,
  img25.src,
  img26.src,
  img27.src,
  img28.src,
  img29.src,
  img30.src,
];
---

<Layout metadata={metadata}>
  <!-- Back to Works Button and Disclaimer -->
  <div class="py-8 pl-4 md:pl-10 pr-4 md:pr-10">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
      <a
        href="/works"
        class="inline-flex items-center gap-2 text-black hover:opacity-70 transition-opacity uppercase tracking-wide text-sm"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to Works
      </a>
      <p class="text-xs uppercase tracking-wide md:text-right max-w-[300px]" style="font-weight: 200;">
        This portfolio was created as an independent design study inspired by the brand's aesthetic and is not
        affiliated with or commissioned by Alice + Olivia
      </p>
    </div>
  </div>

  <FlipBookTurnJS images={journalImages} title="ALICE + OLIVIA: THE MIDDLE OF THE NIGHT" />

  <!-- Coming Soon Section -->
  <div class="w-full pt-4 pb-24 text-center">
    <h2 class="text-2xl md:text-3xl uppercase tracking-wide" style="font-weight: 200;">
      FINAL PRESENTATION COMING SOON....
    </h2>
  </div>
</Layout>

<script is:inline src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script is:inline src="/turn.min.js"></script>
