---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import creativeAndDesign from '~/assets/images/Creative and Design.webp';
import khaite from '~/assets/images/khaite/Untitled.webp';
import aliceOlivia from '~/assets/images/the-middle-of-the-night/design-journal-2/01.webp';
import heatWave from '~/assets/images/works-landing/new-images/Heat Becomes Her.webp';
import pardingtonCollective from '~/assets/images/works-landing/Updated PC.jpeg';
import seDeshabillier from '~/assets/images/works-landing/new-images/Se Deshabiller.webp';
import pcSpring2024 from '~/assets/images/works-landing/new-images/PC Spring.webp';
import interiorDesign from '~/assets/images/works-landing/new-images/Homestead.webp';
import wonderland from '~/assets/images/works-landing/new-images/Wonderland.webp';
import interiorDesign2018 from '~/assets/images/works-landing/new-images/Home Reno.webp';
import amour from '~/assets/images/works-landing/new-images/VS Amour.webp';
import designerCollection from '~/assets/images/works-landing/new-images/VS Designer.webp';
import verySexy from '~/assets/images/works-landing/new-images/VS Very Sexy.webp';
import manipulatedBody from '~/assets/images/works-landing/new-images/Manipulated Body.webp';
import iFeelItInMyBones from '~/assets/images/works-landing/new-images/Feel it in My Bones.webp';
import riding from '~/assets/images/works-landing/new-images/Riding.webp';

const metadata = {
  title: 'Works - Claire Pardington',
};
---

<Layout metadata={metadata}>
  <!-- Headline -->
  <div class="w-full text-center py-12">
    <Image src={creativeAndDesign} alt="Creative Direction & Design" class="mx-auto w-full max-w-[675px] h-auto" />
  </div>

  <!-- Video Background Section -->
  <div class="sticky top-0 w-full max-h-[600px] h-[600px] overflow-hidden bg-black">
    <video
      id="background-video"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      class="w-full h-full object-cover"
      style="max-height: 600px;"
    >
      <source src="/Fashion-BG-Video.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>

  <!-- Content that scrolls over the video -->
  <div class="relative bg-white z-10">
    <div class="container mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <a href="/khaite" class="flex flex-col w-full">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={khaite} alt="Khaite: Architectural Romance" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            KHAITE: ARCHITECTURAL ROMANCE FALL 2025<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 2 -->
        <a href="/alice-olivia-middle-of-the-night" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={aliceOlivia} alt="Alice + Olivia: The Middle of the Night" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            ALICE + OLIVIA: THE MIDDLE OF THE NIGHT<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 3 -->
        <a href="/heat-becomes-her" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={heatWave} alt="Heat Becomes Her" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">HEAT BECOMES HER<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN</p>
        </a>

        <!-- Card 4 -->
        <a href="/pardington-collective" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={pardingtonCollective}
              alt="Pardington Collective Fall 2024"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            PARDINGTON COLLECTIVE: FALL 2024<br />BRAND CREATION, CREATIVE DIRECTION, DESIGN,<br />& EXECUTION OF FIRST
            RTW CLASSICS COLLECTION
          </p>
        </a>

        <!-- Card 5 -->
        <a href="/se-deshabiller" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={seDeshabillier} alt="Se Deshabillier Fall 2024" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            SE DESHABILLIER: FALL 2024<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 6 -->
        <a href="/pardington-collective-spring-2024" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={pcSpring2024} alt="Pardington Collective Spring 2024" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            PARDINGTON COLLECTIVE: SPRING 2024<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 7 -->
        <a href="/interior-design" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={interiorDesign} alt="Interior Design New Home Build 2021" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            INTERIOR DESIGN: NEW HOME BUILD 2021<br />CREATIVE DIRECTION, DESIGN, & PROJECT MANAGER
          </p>
        </a>

        <!-- Card 8 -->
        <a href="/welcome-to-wonderland" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image src={wonderland} alt="Welcome to Wonderland" class="w-full h-full object-cover" />
          </div>
          <p class="text-xs uppercase tracking-wide">
            WELCOME TO WONDERLAND<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 9 -->
        <a href="/home-renovation-2018" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={interiorDesign2018}
              alt="Interior Design Entire Home Renovation 2018"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            INTERIOR DESIGN: ENTIRE HOME RENOVATION 2018<br />CREATIVE DIRECTION, DESIGN, & PROJECT MANAGER
          </p>
        </a>

        <!-- Card 10 -->
        <a href="/vs-amour-collection" class="flex flex-col w-full ">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={amour}
              alt="Victoria's Secret Designer Collection Amour Fall/Holiday 2014"
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            VICTORIA'S SECRET DESIGNER COLLECTION: AMOUR<br />FALL/ HOLIDAY 2014<br />CREATIVE DIRECTION, DESIGN, &
            COLLECTION EXECUTION
          </p>
        </a>

        <!-- Card 11 -->
        <a href="/vs-collected-works" class="flex flex-col w-full group">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={designerCollection}
              alt="Victoria's Secret Designer Collection Collected Works"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            VICTORIA'S SECRET DESIGNER COLLECTION<br />COLLECTED WORKS<br />CREATIVE DIRECTION, DESIGN, & COLLECTION
            EXECUTION
          </p>
        </a>

        <!-- Card 12 -->
        <a href="/vs-very-sexy" class="flex flex-col w-full group">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={verySexy}
              alt="Victoria's Secret Very Sexy Collection"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            VICTORIA'S SECRET VERY SEXY COLLECTION MISC CREATIVE DIRECTION, DESIGN, & COLLECTION EXECUTION
          </p>
        </a>

        <!-- Card 13 -->
        <a href="/manipulated-body" class="flex flex-col w-full group">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={manipulatedBody}
              alt="Manipulated Body"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">MANIPULATED BODY<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN</p>
        </a>

        <!-- Card 14 -->
        <a href="/i-feel-it-in-my-bones" class="flex flex-col w-full group">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={iFeelItInMyBones}
              alt="I Feel It In My Bones"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            I FEEL IT IN MY BONES<br />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>

        <!-- Card 15 -->
        <a href="/riding-the-chemically-imbalanced-rollercoaster" class="flex flex-col w-full group">
          <div class="mb-3 h-[310px] md:h-[320px] w-auto overflow-hidden">
            <Image
              src={riding}
              alt="Riding the Chemically Imbalanced Rollercoaster"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="text-xs uppercase tracking-wide">
            RIDING THE CHEMICALLY IMBALANCED ROLLERCOASTER<br />MAY CAUSE ADVERSE AFFECTS ON THE NERVES, DEAR<br
            />CONCEPTUAL CREATIVE DIRECTION & DESIGN
          </p>
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  console.log('Works page video script loaded - v2025-01-28');
  document.addEventListener('astro:page-load', () => {
    console.log('astro:page-load event fired');
    const video = document.getElementById('background-video') as HTMLVideoElement;
    console.log('Video element found:', !!video);
    if (video) {
      console.log('Video src:', video.currentSrc || video.src);
      console.log('Video readyState:', video.readyState);
      console.log('Video paused:', video.paused);
      console.log('Video muted:', video.muted);

      // Ensure video properties are set
      video.muted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');

      console.log('After setting properties - muted:', video.muted, 'playsInline:', video.playsInline);

      // Force load the video
      console.log('Calling video.load()');
      video.load();

      // Try to play immediately
      const attemptPlay = () => {
        console.log('attemptPlay called, readyState:', video.readyState);
        const playPromise = video.play();

        if (playPromise !== undefined) {
          playPromise
            .then(() => {
              console.log('✅ Video playing successfully');
            })
            .catch((error) => {
              console.error('❌ Autoplay blocked:', error);
              console.log('Will retry on interaction');
              // If autoplay is blocked, try again after user interaction
              const playOnInteraction = () => {
                console.log('User interaction detected, attempting to play...');
                video
                  .play()
                  .then(() => {
                    console.log('✅ Video playing after user interaction');
                  })
                  .catch((err) => {
                    console.error('❌ Failed to play video after interaction:', err);
                  });
              };

              document.addEventListener('click', playOnInteraction, { once: true });
              document.addEventListener('touchstart', playOnInteraction, { once: true });
              document.addEventListener('scroll', playOnInteraction, { once: true });
            });
        }
      };

      // Try to play when video metadata is loaded
      video.addEventListener(
        'loadedmetadata',
        () => {
          console.log('loadedmetadata event fired');
          attemptPlay();
        },
        { once: true }
      );

      // Also try immediately in case it's already loaded
      if (video.readyState >= 2) {
        console.log('Video already loaded, playing immediately');
        attemptPlay();
      } else {
        console.log('Video not ready yet, waiting for loadedmetadata');
      }
    }
  });
</script>
