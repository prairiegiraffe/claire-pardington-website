---
interface Props {
  images: string[];
  title?: string;
  height?: number;
  id?: string; // Unique ID to prevent conflicts
}

const { images, title, height = 600, id = 'flipbook-double' } = Astro.props;
const uniqueId = `${id}-${Math.random().toString(36).substring(2, 11)}`;
---

<div
  class="flipbook-double-container max-w-7xl mx-auto px-4 pb-16"
  style={`--flipbook-height: ${height}px`}
  data-flipbook-type="double-cover"
>
  {
    title && (
      <h1 class="text-4xl text-center mb-12" style="font-weight: 200;">
        {title}
      </h1>
    )
  }

  <div id={uniqueId} class="flipbook-double" data-flipbook-id={uniqueId}>
    {
      images.map((image, index) => (
        <div class:list={['page-double', index === images.length - 1 ? 'hard' : '']} data-page-index={index}>
          <img src={image} alt={`Page ${index + 1}`} class="page-image-double" />
        </div>
      ))
    }
  </div>

  <!-- Navigation Controls -->
  <div class="navigation-controls flex justify-center items-center gap-2 md:gap-8 mt-8">
    <button
      class="nav-btn-double prev-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      data-flipbook-target={uniqueId}
      aria-label="Previous page"
    >
      ← Prev
    </button>

    <div class="page-counter text-sm md:text-lg text-center">
      <span class="current-page-double" data-flipbook-target={uniqueId}>1</span> / <span
        class="total-pages-double"
        data-flipbook-target={uniqueId}>{Math.ceil(images.length / 2)}</span
      >
    </div>

    <button
      class="nav-btn-double next-btn px-3 md:px-6 py-2 md:py-3 bg-black text-white hover:bg-gray-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed text-sm md:text-base"
      data-flipbook-target={uniqueId}
      aria-label="Next page"
    >
      Next →
    </button>
  </div>
</div>

<style>
  .flipbook-double-container {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flipbook-double {
    width: 1000px;
    height: var(--flipbook-height, 600px);
  }

  @media (max-width: 768px) {
    .flipbook-double {
      width: 90vw !important;
      height: 60vh !important;
    }
  }

  .page-double {
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .page-double.hard {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-double.even {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-double.odd {
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 1) 55%,
      rgba(235, 235, 235, 1) 100%
    );
  }

  .page-image-double {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hide flipbook pages until turn.js initializes */
  .flipbook-double .page-double {
    display: none;
  }

  .flipbook-double.turn-initialized .page-double {
    display: flex !important;
  }
</style>

<script>
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  declare const jQuery: any;

  document.addEventListener('astro:page-load', function () {
    // Initialize all double-cover flipbooks on the page
    const flipbooks = document.querySelectorAll('[data-flipbook-type="double-cover"]');

    flipbooks.forEach((container) => {
      const flipbookElement = container.querySelector('.flipbook-double') as HTMLElement;
      if (!flipbookElement) return;

      const uniqueId = flipbookElement.dataset.flipbookId;
      if (!uniqueId) return;

      // Wait for jQuery and turn.js to be available
      function initFlipbook() {
        if (typeof jQuery === 'undefined' || typeof jQuery.fn.turn === 'undefined') {
          setTimeout(initFlipbook, 100);
          return;
        }

        // Check if already initialized
        if (flipbookElement.classList.contains('turn-initialized')) {
          return;
        }

        const prevBtn = container.querySelector(
          '.prev-btn[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLButtonElement;
        const nextBtn = container.querySelector(
          '.next-btn[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLButtonElement;
        const currentPageEl = container.querySelector(
          '.current-page-double[data-flipbook-target="' + uniqueId + '"]'
        ) as HTMLElement;

        if (!prevBtn || !nextBtn || !currentPageEl) return;

        // Initialize turn.js with responsive settings
        const isMobile = window.innerWidth < 768;

        // For double cover on desktop:
        // Turn.js in double mode shows: odd pages on RIGHT, even pages on LEFT
        // View at page 1 = ONLY page 1 (right side, left is blank)
        // View at page 2 = page 2 (left) + page 3 (right)
        //
        // To show images[0] and images[1] together as a double cover:
        // We want them as LEFT + RIGHT
        // So images[0] needs to be on LEFT (even page) and images[1] on RIGHT (odd page)
        // This means: blank, images[0], images[1], images[2]...
        // When we view page 2, we see: images[0] (left) + images[1] (right) ✓

        if (!isMobile) {
          const blankPage = document.createElement('div');
          blankPage.className = 'page-double blank-page';
          blankPage.style.background = 'white';
          flipbookElement.insertBefore(blankPage, flipbookElement.firstChild);
        }

        const customHeight = parseInt((container as HTMLElement).style.getPropertyValue('--flipbook-height') || '600');

        jQuery(flipbookElement).turn({
          width: isMobile ? window.innerWidth * 0.9 : 1000,
          height: isMobile ? window.innerHeight * 0.6 : customHeight,
          display: isMobile ? 'single' : 'double',
          autoCenter: true,
          gradients: true,
          acceleration: true,
          elevation: 50,
          duration: 1000,
        });

        // Start at page 2 on desktop - this shows blank (left) + page 1 (right) together
        // Then pages 2-3, 4-5, etc.
        if (!isMobile) {
          jQuery(flipbookElement).turn('page', 2);
        }

        // Mark as initialized
        flipbookElement.classList.add('turn-initialized');

        // Handle window resize
        let resizeTimeout: number;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(function () {
            const nowMobile = window.innerWidth < 768;
            jQuery(flipbookElement).turn('display', nowMobile ? 'single' : 'double');
            jQuery(flipbookElement).turn(
              'size',
              nowMobile ? window.innerWidth * 0.9 : 1000,
              nowMobile ? window.innerHeight * 0.6 : customHeight
            );
          }, 250) as unknown as number;
        });

        function updateControls() {
          const page = jQuery(flipbookElement).turn('page');
          const nowMobile = window.innerWidth < 768;

          // For double cover book:
          let displaySpread: number;
          let isFirstPage: boolean;
          let isLastPage: boolean;

          if (nowMobile) {
            // On mobile (single page mode) - just show page number
            displaySpread = page;
            isFirstPage = page === 1;
            const totalMobilePages = flipbookElement.querySelectorAll('.page-double').length;
            isLastPage = page === totalMobilePages;
          } else {
            // On desktop (double page mode) with blank first page
            // Page 2 is the first view (shows images 0+1), so display as "spread 1"
            displaySpread = page > 1 ? Math.ceil((page - 1) / 2) : 1;
            isFirstPage = page === 2; // Page 2 is actually first content view
            const totalDesktopPages = flipbookElement.querySelectorAll('.page-double').length;
            isLastPage = page >= totalDesktopPages;
          }

          if (currentPageEl) {
            currentPageEl.textContent = displaySpread.toString();
          }
          prevBtn.disabled = isFirstPage;
          nextBtn.disabled = isLastPage;
        }

        prevBtn.addEventListener('click', () => {
          jQuery(flipbookElement).turn('previous');
          updateControls();
        });

        nextBtn.addEventListener('click', () => {
          jQuery(flipbookElement).turn('next');
          updateControls();
        });

        jQuery(flipbookElement).bind('turned', function () {
          updateControls();
        });

        // Initialize controls
        updateControls();
      }

      initFlipbook();
    });
  });
</script>
